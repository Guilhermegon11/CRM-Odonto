# Branding
NEXT_PUBLIC_CLINIC_NAME="Clínica Sorriso"
NEXT_PUBLIC_DEMO_MODE="true"

# CRM <-> n8n
# URL de um Webhook do n8n que receberá pedidos de envio do CRM.
N8N_WEBHOOK_URL=""

# Segredo compartilhado. No n8n, envie em Authorization: Bearer <segredo>
# ou X-CRM-Secret: <segredo> ao chamar /api/n8n/inbound.
CRM_WEBHOOK_SECRET="troque-por-um-segredo-forte"

# Opcional - reservado para a próxima etapa com persistência real no Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
